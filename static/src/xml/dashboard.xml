<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="omni_referral_base.ReferralDashboard">
        <div class="o_referral_dashboard">

            <!-- Header -->
            <div class="o_dashboard_header d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa fa-bar-chart text-primary" style="font-size:22px;"/>
                    <h4 class="mb-0 fw-bold">Referral Dashboard</h4>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="text-muted" style="font-size:13px;">Period:</span>
                    <select class="form-select form-select-sm o_dashboard_period_select"
                            t-on-change="onPeriodChange">
                        <option value="this_month">This Month</option>
                        <option value="last_3_months">Last 3 Months</option>
                        <option value="last_6_months">Last 6 Months</option>
                        <option value="this_year">This Year</option>
                    </select>
                </div>
            </div>

            <!-- Loading -->
            <t t-if="state.loading">
                <div class="o_dashboard_loading">
                    <i class="fa fa-spinner fa-spin fa-2x text-primary"/>
                    <span class="ms-3 text-muted">Loading dashboard...</span>
                </div>
            </t>

            <t t-elif="state.data">

                <!-- KPI Cards -->
                <div class="o_dashboard_kpi_grid">
                    <div class="o_kpi_card">
                        <div class="o_kpi_icon" style="background:#f0eff5;">
                            <i class="fa fa-users" style="color:#71639e;"/>
                        </div>
                        <div class="o_kpi_body">
                            <div class="o_kpi_label">Total Members</div>
                            <div class="o_kpi_value">
                                <t t-esc="formatNumber(state.data.kpi.total_members)"/>
                            </div>
                            <div class="o_kpi_sub">All time</div>
                        </div>
                    </div>
                    <div class="o_kpi_card">
                        <div class="o_kpi_icon" style="background:#f0eff5;">
                            <i class="fa fa-diamond" style="color:#71639e;"/>
                        </div>
                        <div class="o_kpi_body">
                            <div class="o_kpi_label">Active Members</div>
                            <div class="o_kpi_value"  >
                                <t t-esc="formatNumber(state.data.kpi.active_members)"/>
                            </div>
                            <div class="o_kpi_sub">All time</div>
                        </div>
                    </div>
                    <div class="o_kpi_card">
                        <div class="o_kpi_icon" style="background:#f0eff5;">
                            <i class="fa fa-percent" style="color:#71639e;"/>
                        </div>
                        <div class="o_kpi_body">
                            <div class="o_kpi_label">Commission Approved</div>
                            <div class="o_kpi_value" >
                                <t t-esc="formatCurrency(state.data.kpi.total_commission)"/>
                            </div>
                            <div class="o_kpi_sub" t-esc="periodLabel"/>
                        </div>
                    </div>
                    <div class="o_kpi_card">
                        <div class="o_kpi_icon" style="background:#f0eff5;">
                            <i class="fa fa-money" style="color:#71639e;"/>
                        </div>
                        <div class="o_kpi_body">
                            <div class="o_kpi_label">Withdrawal Paid</div>
                            <div class="o_kpi_value" >
                                <t t-esc="formatCurrency(state.data.kpi.total_withdrawal)"/>
                            </div>
                            <div class="o_kpi_sub" t-esc="periodLabel"/>
                        </div>
                    </div>
                </div>

                <!-- Charts Row -->
                <div class="o_dashboard_charts_grid">

                    <!-- Commission Trend -->
                    <div class="o_dashboard_chart_card">
                        <div class="o_chart_card_header">
                            <i class="fa fa-bar-chart me-2" style="color:#71639e;"/>
                            <span class="fw-semibold">Commission Trend</span>
                            <span class="text-muted ms-2" style="font-size:11px;"
                                  t-esc="'(' + periodLabel + ')'"/>
                        </div>
                        <div t-ref="chartCommission" class="o_chart_canvas"/>
                    </div>

                    <!-- Member Growth -->
                    <div class="o_dashboard_chart_card">
                        <div class="o_chart_card_header">
                            <i class="fa fa-line-chart me-2" style="color:#71639e;"/>
                            <span class="fw-semibold">Member Growth</span>
                            <span class="text-muted ms-2" style="font-size:11px;"
                                  t-esc="'(' + periodLabel + ')'"/>
                        </div>
                        <div t-ref="chartMember" class="o_chart_canvas"/>
                    </div>
                </div>
                 <!-- ── Bottom Section ── -->
                <div class="o_dashboard_bottom_grid">

                    <!-- Top 5 Members -->
                    <div class="o_dashboard_card">
                        <div class="o_card_header">
                            <i class="fa fa-trophy me-2" style="color:#71639e;"/>
                            <span class="fw-semibold">Top 5 Members</span>
                            <span class="text-muted ms-1" style="font-size:11px;">by commission balance</span>
                        </div>
                        <t t-if="state.data.top_members.length == 0">
                            <div class="o_empty_state">
                                <i class="fa fa-users fa-2x text-muted mb-2"/>
                                <div class="text-muted">No active members with balance yet</div>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="o_top_members_list">
                                <t t-foreach="state.data.top_members" t-as="m" t-key="m.id">
                                
                                    <div class="o_top_member_row"
                                        t-att-data-member-id="m.id"
                                        t-on-click="onClickMember">
                                        <div class="o_rank_badge" t-att-class="m_index == 0 ? 'rank-gold' : m_index == 1 ? 'rank-silver' : m_index == 2 ? 'rank-bronze' : 'rank-default'">
                                            <t t-esc="m_index + 1"/>
                                        </div>
                                        <img t-att-src="m.avatar_url"
                                             class="o_member_mini_avatar"
                                             onerror="this.src='/web/static/img/placeholder.png'"/>
                                        <div class="o_member_mini_info">
                                            <div class="fw-semibold text-truncate" style="font-size:13px;" t-esc="m.name"/>
                                            <div class="text-muted" style="font-size:11px;font-family:monospace;" t-esc="m.member_code"/>
                                        </div>
                                        <div class="ms-auto text-end">
                                            <div class="fw-bold" style="font-size:13px;color:#71639e;"
                                                 t-esc="formatCurrency(m.commission_balance)"/>
                                            <div class="text-muted" style="font-size:10px;">
                                                <t t-esc="m.downline_count"/> downline(s)
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </div>

                    <!-- Pending Commissions -->
                    <div class="o_dashboard_card">
                        <div class="o_card_header">
                            <i class="fa fa-clock-o me-2" style="color:#71639e;"/>
                            <span class="fw-semibold">Pending Commissions</span>
                            <span class="ms-auto">
                                <span class="badge rounded-pill bg-warning text-dark" style="font-size:10px;"
                                      t-esc="state.data.pending_commissions.length + ' pending'"/>
                            </span>
                        </div>
                        <t t-if="state.data.pending_commissions.length == 0">
                            <div class="o_empty_state">
                                <i class="fa fa-check-circle fa-2x text-success mb-2"/>
                                <div class="text-muted">All commissions are up to date!</div>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="o_pending_table_wrap">
                                <table class="o_pending_table">
                                    <thead>
                                        <tr>
                                            <th>Member</th>
                                            <th>Sales Order</th>
                                            <th>Lvl</th>
                                            <th>Amount</th>
                                            <th>Date</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.data.pending_commissions" t-as="c" t-key="c.id">
                                            <tr>
                                                <td>
                                                    <div class="fw-semibold" style="font-size:12px;" t-esc="c.beneficiary"/>
                                                    <div class="text-muted" style="font-size:10px;font-family:monospace;" t-esc="c.beneficiary_code"/>
                                                </td>
                                                <td style="font-size:12px;" t-esc="c.sale_order"/>
                                                <td>
                                                    <span class="badge rounded-pill bg-light text-dark border" style="font-size:10px;">
                                                        L<t t-esc="c.level_depth"/>
                                                    </span>
                                                </td>
                                                <td class="fw-semibold" style="font-size:12px;color:#059669;"
                                                    t-esc="formatCurrency(c.commission_amount)"/>
                                                <td class="text-muted" style="font-size:11px;" t-esc="c.create_date"/>
                                                <td>
                                                    <div class="d-flex gap-1">
                                                        <!-- Approve button -->
                                                        <button class="btn btn-xs btn-success"
                                                                t-att-data-commission-id="c.id"
                                                                t-att-data-member-name="c.beneficiary"
                                                                t-att-data-amount="formatCurrency(c.commission_amount)"
                                                                t-on-click="onClickApprove">
                                                            <i class="fa fa-check"/>
                                                        </button>

                                                        <!-- Reject button -->
                                                        <button class="btn btn-xs btn-danger"
                                                                t-att-data-commission-id="c.id"
                                                                t-att-data-member-name="c.beneficiary"
                                                                t-att-data-amount="formatCurrency(c.commission_amount)"
                                                                t-on-click="onClickReject">
                                                            <i class="fa fa-times"/>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </t>
                    </div>

                </div>
            </t>
        </div>
    </t>
</templates>