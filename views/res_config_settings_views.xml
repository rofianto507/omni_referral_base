<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_omni_referral" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.omni.referral</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Omni Referral" name="omni_referral_base">
                    <block title="Member Settings">
                        <setting string="Member Code Prefix"
                                 help="Set prefix for member code, e.g. MEM, REF, ORG.">
                            <field name="referral_member_code_prefix"/>
                        </setting>
                    </block>

                    <!-- Commission Settings -->
                    <block title="Commission Settings">
                        <setting string="Auto-Approve Commission for Active Upline"
                                 help="Automatically approve commission for uplines who have confirmed Sales Orders within the active period.">
                            <field name="referral_auto_approve_active_upline"/>
                        </setting>
                        <setting string="Skip Commission for Inactive Upline"
                                 help="If enabled, commission is NOT created for inactive uplines (no confirmed SO within active period). If disabled, commission stays Pending for manual review."
                                 attrs="{'invisible': [('referral_auto_approve_active_upline', '=', False)]}">
                            <field name="referral_skip_inactive_upline"/>
                        </setting>
                        <setting string="Active Period (Days)"
                                help="Number of days to look back when checking if an upline has been active. Default is 30 days."
                                attrs="{'invisible': [('referral_auto_approve_active_upline', '=', False)]}">
                            <field name="referral_active_upline_days"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_omni_referral_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'omni_referral_base'}</field>
    </record>
</odoo>