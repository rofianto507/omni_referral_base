<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_referral_member_list" model="ir.ui.view">
            <field name="name">referral.member.list</field>
            <field name="model">referral.member</field>
            <field name="arch" type="xml">
                <list string="Members">
                    <field name="member_code"/>
                    <field name="partner_id"/>
                    <field name="sponsor_id"/>
                    <field name="join_date"/>
                    <field name="downline_count"/>
                    <field name="commission_balance"/>
                    <field name="state"
                        widget="badge"
                        decoration-muted="state == 'draft'"
                        decoration-success="state == 'active'"
                        decoration-warning="state == 'suspended'"
                        decoration-danger="state == 'terminated'"/>
                </list>
            </field>
        </record>
         <!-- Kanban -->
        <record id="view_referral_member_kanban" model="ir.ui.view">
            <field name="name">referral.member.kanban</field>
            <field name="model">referral.member</field>
            <field name="arch" type="xml">
                <kanban class="o_referral_member_kanban" default_group_by="state">
                    <field name="id"/>
                    <field name="member_code"/>
                    <field name="partner_id"/>
                    <field name="partner_image"/>
                    <field name="sponsor_id"/>
                    <field name="join_date"/>
                    <field name="state"/>
                    <field name="downline_count"/>
                    <field name="commission_balance"/>
                    <field name="currency_id"/>
                    <templates>
                        <t t-name="card">
                            <div class="o_kanban_card_header d-flex align-items-center gap-3 p-3">
                                <!-- partner photo -->
                               <t t-if="record.partner_id.raw_value">
                                    <img t-att-src="'/web/image/res.partner/' + record.partner_id.raw_value + '/image_128'"
                                        class="o_member_avatar rounded-circle"
                                        style="width:52px;height:52px;object-fit:cover;flex-shrink:0;"
                                        alt="Member Photo"
                                        onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"/>
                                    <div class="o_member_avatar_fallback rounded-circle d-flex align-items-center justify-content-center"
                                        style="width:52px;height:52px;background:#e5e7eb;flex-shrink:0;display:none!important;">
                                        <i class="fa fa-user fa-lg text-muted"/>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="o_member_avatar_fallback rounded-circle d-flex align-items-center justify-content-center"
                                        style="width:52px;height:52px;background:#e5e7eb;flex-shrink:0;">
                                        <i class="fa fa-user fa-lg text-muted"/>
                                    </div>
                                </t>

                                <!-- Nama & kode -->
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="fw-bold text-truncate fs-6">
                                        <field name="partner_id"/>
                                    </div>
                                    <div class="text-muted" style="font-size:11.5px;font-family:monospace;">
                                        <field name="member_code"/>
                                    </div>
                                </div>

                                <!-- State badge -->
                                <div>
                                    <field name="state" widget="badge"
                                           decoration-muted="state == 'draft'"
                                           decoration-success="state == 'active'"
                                           decoration-warning="state == 'suspended'"
                                           decoration-danger="state == 'terminated'"/>
                                </div>
                            </div>

                            <div class="p-3 pt-0" style="border-top:1px solid #f3f4f6;">
                                <!-- Sponsor -->
                                <div class="d-flex align-items-center gap-2 mb-1" style="font-size:12px;">
                                    <i class="fa fa-user-o text-muted"/>
                                    <span class="text-muted">Sponsor:</span>
                                    <span class="fw-semibold">
                                        <t t-if="record.sponsor_id.value">
                                            <field name="sponsor_id"/>
                                        </t>
                                        <t t-else="">
                                            <span class="text-muted fst-italic">—</span>
                                        </t>
                                    </span>
                                </div>

                                <!-- Join date -->
                                <div class="d-flex align-items-center gap-2 mb-1" style="font-size:12px;">
                                    <i class="fa fa-calendar text-muted"/>
                                    <span class="text-muted">Joined:</span>
                                    <field name="join_date"/>
                                </div>

                                <!-- Stats row -->
                                <div class="d-flex justify-content-between mt-2 pt-2"
                                     style="border-top:1px dashed #e5e7eb;font-size:12px;">
                                    <div class="text-center">
                                        <div class="fw-bold text-primary">
                                            <field name="downline_count"/>
                                        </div>
                                        <div class="text-muted" style="font-size:10px;">Downlines</div>
                                    </div>
                                    <div class="text-center">
                                        <div class="fw-bold text-success">
                                            <field name="commission_balance"
                                                   widget="monetary"
                                                   options="{'currency_field': 'currency_id'}"/>
                                        </div>
                                        <div class="text-muted" style="font-size:10px;">Balance</div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        <record id="view_referral_member_form" model="ir.ui.view">
            <field name="name">referral.member.form</field>
            <field name="model">referral.member</field>
            <field name="arch" type="xml">
                <form string="Member">
                    <header>
                        <button name="action_activate" type="object" string="Activate"
                                invisible="state != 'draft'" class="btn-primary"/>
                        <button name="action_suspend" type="object" string="Suspend"
                                invisible="state != 'active'"/>
                        <button name="action_reactivate" type="object" string="Reactivate"
                                invisible="state != 'suspended'" class="btn-primary"/>
                        <button name="action_terminate" type="object" string="Terminate"
                                invisible="state != 'suspended'"
                                confirm="Member cannot be reactivated. Are you sure?"/>
                        <button name="action_withdraw"
                                type="object"
                                string="Withdraw Commission"
                                class="btn-warning"
                                invisible="commission_balance &lt;= 0"/>
                        <button name="action_print_member_card"
                                type="object"
                                string="Print Member Card"
                                invisible="state != 'active'"
                                class="btn-primary"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,active,suspended,terminated"/>
                    </header>
                    <sheet>
                        <!-- Smart Buttons -->
                        <div name="button_box" class="oe_button_box">
                            <button name="action_view_sale_orders"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-shopping-cart"
                                    invisible="sale_order_count == 0">
                                <field name="sale_order_count"
                                       string="Sales"
                                       widget="statinfo"/>
                            </button>
                            <button name="action_view_commissions"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-percent"
                                    invisible="commission_count == 0">
                                <field name="commission_count"
                                       string="Commissions"
                                       widget="statinfo"/>
                            </button>
                            <button name="action_view_withdrawals"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-money"
                                    invisible="withdraw_count == 0">
                                <field name="withdraw_count"
                                       string="Withdrawals"
                                       widget="statinfo"/>
                            </button>
                        </div>
                        <div class="d-flex gap-4 mb-3">
                            <field name="partner_image" widget="image" 
                            style="width:80px;height:80px;object-fit:cover;border-radius:50%;border:2px solid #e5e7eb;"/>
                            <div class="flex-grow-1">
                                <group>
                                    <group string="Member Info">
                                        <field name="member_code" readonly="1"/>
                                        <field name="partner_id"/>
                                        <field name="phone"/>
                                        <field name="email"/>
                                        <field name="sponsor_id"/>
                                        <field name="join_date"/>
                                        <field name="downline_count" readonly="1"/>
                                    </group>
                                    <group string="Commission Summary">
                                        <field name="currency_id" invisible="1"/>
                                        <field name="commission_total_earned" readonly="1"/>
                                        <field name="commission_total_pending" readonly="1"/>
                                        <field name="commission_withdrawn" readonly="1"/>
                                        <field name="commission_balance" readonly="1"/>
                                    </group>
                                </group>
                            </div>
                        </div>
                        <notebook>
                            <page string="Direct Downlines">
                                <field name="downline_ids" readonly="1">
                                    <list string="Downlines">
                                        <field name="member_code"/>
                                        <field name="partner_id"/>
                                        <field name="join_date"/>
                                        <field name="state" widget="badge"
                                               decoration-muted="state == 'draft'"
                                               decoration-success="state == 'active'"
                                               decoration-warning="state == 'suspended'"
                                               decoration-danger="state == 'terminated'"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Commissions">
                                <field name="commission_ids" readonly="1">
                                    <list string="Commissions">
                                        <field name="sale_order_id"/>
                                        <field name="source_member_id"/>
                                        <field name="level_depth"/>
                                        <field name="commission_pct" string="Rate (%)"/>
                                        <field name="base_amount"/>
                                        <field name="commission_amount" string="Amount"/>
                                        <field name="state" widget="badge"
                                               decoration-muted="state == 'pending'"
                                               decoration-success="state == 'approved'"
                                               decoration-danger="state == 'rejected'"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Withdrawals">
                                <field name="withdraw_ids" readonly="1">
                                    <list string="Withdrawals">
                                        <field name="name"/>
                                        <field name="date_request"/>
                                        <field name="amount"/>
                                        <field name="commission_balance_before"/>
                                        <field name="commission_balance_after"/>
                                        <field name="date_paid"/>
                                        <field name="state" widget="badge"
                                               decoration-muted="state == 'draft'"
                                               decoration-info="state == 'submitted'"
                                               decoration-warning="state == 'approved'"
                                               decoration-success="state == 'paid'"
                                               decoration-danger="state == 'rejected'"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter>
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </chatter>
                </form>
            </field>
        </record>

        <record id="view_referral_member_search" model="ir.ui.view">
            <field name="name">referral.member.search</field>
            <field name="model">referral.member</field>
            <field name="arch" type="xml">
                <search string="Search Members">
                    <field name="member_code"/>
                    <field name="partner_id"/>
                    <field name="sponsor_id"/>
                    <filter name="filter_active" string="Active" domain="[('state','=','active')]"/>
                    <filter name="filter_has_balance" string="Has Balance"
                            domain="[('commission_balance','>',0)]"/>
                    <group>
                        <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                        <filter name="group_sponsor" string="Sponsor" context="{'group_by': 'sponsor_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_referral_member" model="ir.actions.act_window">
            <field name="name">Members</field>
            <field name="res_model">referral.member</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="search_view_id" ref="view_referral_member_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first member
                </p>
                <p>
                    Register members and connect them with sponsors.
                </p>
            </field>
        </record>
    </data>
</odoo>