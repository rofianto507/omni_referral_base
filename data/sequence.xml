<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_referral_member_code" model="ir.sequence">
            <field name="name">Referral Member Code</field>
            <field name="code">omni.referral.member.code</field>
            <field name="prefix">MEM</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
        <record id="seq_commission_withdraw" model="ir.sequence">
            <field name="name">Commission Withdraw</field>
            <field name="code">omni.referral.commission.withdraw</field>
            <field name="prefix">WD/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>