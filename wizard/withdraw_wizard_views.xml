<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_withdraw_wizard_form" model="ir.ui.view">
        <field name="name">withdraw.wizard.form</field>
        <field name="model">withdraw.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Withdrawal">
                <sheet>
                    <group>
                        <field name="member_id" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="commission_balance" readonly="1"/>
                        <field name="amount"/>
                        <field name="note" placeholder="Optional notes..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Confirm Withdraw"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>